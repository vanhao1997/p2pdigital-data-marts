{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Admicro Extractor",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Job latency p95",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(admicro_extractor_job_duration_ms_bucket[5m])))",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Provider error rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(admicro_extractor_jobs_total{status=\"failed\",error_type=\"provider\"}[5m])) / clamp_min(sum(rate(admicro_extractor_jobs_total{status=~\"success|failed|cancelled\"}[5m])), 1)",
          "legendFormat": "provider errors"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Retry and rate-limit pressure",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(admicro_extractor_retry_attempts_total[5m])",
          "legendFormat": "retry attempts"
        },
        {
          "expr": "sum(rate(admicro_extractor_jobs_total{status=\"failed\",error_type=\"rate_limit\"}[5m]))",
          "legendFormat": "rate limited"
        },
        {
          "expr": "sum(rate(admicro_extractor_jobs_total{status=\"rejected\"}[5m]))",
          "legendFormat": "rejected"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Chromium lifecycle",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "admicro_extractor_browser_active",
          "legendFormat": "active browsers"
        },
        {
          "expr": "rate(admicro_extractor_browser_launch_failures_total[5m])",
          "legendFormat": "launch failures"
        },
        {
          "expr": "admicro_extractor_process_resident_memory_bytes",
          "legendFormat": "RSS"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ]
}
